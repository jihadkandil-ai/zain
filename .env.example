# Tamara LLM Proxy (preferred — request virtual key via #it-helpdesk)
# Form: https://forms.gle/rvu7rSrBjXt71Gcm6
# Models: https://llmproxy.dwh.tamara.co/ui/model_hub_table/
LLM_PROXY_API_KEY=your_virtual_key_here
LLM_PROXY_BASE_URL=https://security-proxy.tamaratech.co/v1
LLM_MODEL=openrouter/deepseek/deepseek-v4-flash

# Legacy alias: if LLM_PROXY_API_KEY is empty, GEMINI_API_KEY is also accepted as the proxy key.
# GEMINI_API_KEY=
